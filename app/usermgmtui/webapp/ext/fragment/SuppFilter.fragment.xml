            path: 'filterValues>',
            type: 'sap.fe.macros.filter.type.Value',
            formatOptions: {
                operator: 'hpbuysell.mdm.usermgmtui.ext.fragment.SuppFilter.filterItems'
            }
        }"/>
</core:FragmentDefinition>