        id="SupplierFilterMultiInput"
        width="100%"
        showValueHelp="true"
        core:require="{handler:'hpbuysell/mdm/usermgmtui/ext/fragment/SuppFilter'}"
        valueHelpRequest="handler.onValueHelpRequest"
        tokenUpdate="handler.onTokenUpdate"
