<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog
        id="vhdForProjectsFilter"
        title="Select Projects" 
        contentWidth="60%">
        <content>
            <Table
                id="vhdForProjects_table"
                items="{path: '/ProjectMaster', sorter: { path: 'projectId' }}"
                mode="MultiSelect">
                <columns>
                    <Column><Text text="Project ID"/></Column>
                    <Column><Text text="Project Name"/></Column>
                </columns>
                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <Text text="{projectId}"/>
                            <Text text="{projectName}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <beginButton>
            <Button text="OK" core:require="{ handler: 'hpbuysell/mdm/usermgmtui/ext/fragment/SuppMngProjColumn' }" press="handler.vhdForProjects_onOK"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" core:require="{ handler: 'hpbuysell/mdm/usermgmtui/ext/fragment/SuppMngProjColumn' }" press="handler.vhdForProjects_onCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>